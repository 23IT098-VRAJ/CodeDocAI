# =============================================================================
# CodeDocAI — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your API keys.
#
# Gemini API Keys: https://aistudio.google.com/app/apikey
# Groq API Keys:   https://console.groq.com/keys
# =============================================================================

# --- Google Gemini (Primary Cloud LLM) ---
# At minimum, one Gemini key is required for architecture synthesis and Q&A.
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# --- Groq (Failover Cloud LLM) ---
# Optional but recommended. Provides fallback when Gemini keys hit rate limits.
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
